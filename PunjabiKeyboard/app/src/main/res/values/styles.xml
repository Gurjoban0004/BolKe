<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Regular key style -->
    <style name="KeyStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:hapticFeedbackEnabled">true</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ===== App shell: bento tiles, off-white, Material-style rounding ===== -->

    <style name="Bento">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bento_card</item>
        <item name="android:padding">22dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- Half-width tile for side-by-side rows. Height matches so the row reads as a pair. -->
    <style name="Bento.Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="Bento.Headline" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Bento.CardTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Bento.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/app_text_soft</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Bento.Value" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="Bento.Body" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/app_text_soft</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="Bento.Choice" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:buttonTint">@color/app_primary</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Bento.Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textColorHint">@color/app_text_soft</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Bento.PillPrimary" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/pill_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Bento.PillGhost" parent="Bento.PillPrimary">
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/pill_ghost</item>
        <item name="android:textColor">@color/app_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Special key style (shift, backspace, symbols) -->
    <style name="KeyStyleSpecial">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/key_bg_special</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:hapticFeedbackEnabled">true</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
