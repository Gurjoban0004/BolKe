    <!-- Privacy and support -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_audio">When you use voice typing, Android speech recognition receives the current audio. BolKe then sends only the recognized Punjabi text to the private language service when online wording is enabled.</string>
    <string name="privacy_clipboard">When copied-message translation is enabled, BolKe sends only a newly copied plain-text WhatsApp message. It does not read the screen or clipboard history.</string>
    <string name="privacy_retention">BolKe does not retain audio, copied messages, or translations. Your approved spellings stay on this phone unless you export them.</string>
    <string name="secure_field_explanation">BolKe turns off voice and clipboard tools in password and payment fields.</string>
