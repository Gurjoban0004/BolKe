<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- Welcome -->
        <LinearLayout
            style="@style/Bento"
            android:background="@drawable/bento_primary"
            android:paddingVertical="32dp">

            <TextView
                style="@style/Bento.Headline"
                android:textColor="@color/app_on_primary_soft"
                android:text="@string/setup_welcome_title" />

            <TextView
                style="@style/Bento.Body"
                android:layout_marginTop="8dp"
                android:textSize="15sp"
                android:textColor="@color/app_on_primary_soft"
                android:text="@string/setup_welcome_subtitle" />
        </LinearLayout>

        <!-- Step 1 -->
        <LinearLayout
            android:id="@+id/step1_container"
            style="@style/Bento">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/step1_indicator"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bento_soft"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/app_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Bento.CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="@string/setup_step1_title" />

                <TextView
                    android:id="@+id/step1_check"
                    style="@style/Bento.Label"
                    android:textColor="@color/app_primary"
                    android:visibility="gone"
                    android:text="@string/setup_done_label" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_enable_keyboard"
                style="@style/Bento.PillGhost"
                android:layout_marginTop="14dp"
                android:text="@string/setup_step1_btn" />
        </LinearLayout>

        <!-- Step 2 -->
        <LinearLayout
            android:id="@+id/step2_container"
            style="@style/Bento">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/step2_indicator"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bento_soft"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/app_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Bento.CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="@string/setup_step2_title" />

                <TextView
                    android:id="@+id/step2_check"
                    style="@style/Bento.Label"
                    android:textColor="@color/app_primary"
                    android:visibility="gone"
                    android:text="@string/setup_done_label" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_select_keyboard"
                style="@style/Bento.PillGhost"
                android:layout_marginTop="14dp"
                android:text="@string/setup_step2_btn" />
        </LinearLayout>

        <!-- Step 3 -->
        <LinearLayout
            android:id="@+id/step3_container"
            style="@style/Bento"
            android:background="@drawable/bento_green">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/step3_indicator"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bento_card"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/app_on_green_soft"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Bento.CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:textColor="@color/app_on_green_soft"
                    android:text="@string/setup_step3_title" />
            </LinearLayout>

            <TextView
                style="@style/Bento.Body"
                android:layout_marginTop="8dp"
                android:textColor="@color/app_on_green_soft"
                android:text="@string/setup_step3_desc" />

            <TextView
                android:id="@+id/btn_microphone_permission"
                style="@style/Bento.PillGhost"
                android:layout_marginTop="14dp"
                android:text="@string/setup_microphone_btn" />

            <CheckBox
                android:id="@+id/setup_translate_copied"
                style="@style/Bento.Choice"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/copy_translate_opt_in"
                android:textColor="@color/app_on_green_soft" />

            <TextView
                style="@style/Bento.Body"
                android:text="@string/setup_copy_privacy"
                android:textColor="@color/app_on_green_soft" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_done"
            style="@style/Bento.PillPrimary"
            android:layout_marginTop="8dp"
            android:text="@string/setup_done_btn" />

    </LinearLayout>
</ScrollView>
