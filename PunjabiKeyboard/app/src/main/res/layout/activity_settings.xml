<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/Bento.Headline" android:text="@string/app_name" />
                <TextView style="@style/Bento.Body" android:layout_marginTop="2dp" android:text="@string/settings_title" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_app_size_minus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pill_ghost"
                android:clickable="true"
                android:contentDescription="Decrease app text size"
                android:focusable="true"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/app_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btn_app_size_plus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/pill_ghost"
                android:clickable="true"
                android:contentDescription="Increase app text size"
                android:focusable="true"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/app_primary"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/Bento"
            android:background="@drawable/bento_green">

            <TextView
                style="@style/Bento.CardTitle"
                android:text="@string/test_keyboard_title"
                android:textColor="@color/app_on_green_soft" />

            <EditText
                android:id="@+id/keyboard_test_input"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/field_bg"
                android:hint="@string/test_keyboard_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:paddingHorizontal="16dp"
                android:textColor="@color/app_text"
                android:textColorHint="@color/app_text_soft"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btn_try_keyboard"
                style="@style/Bento.PillGhost"
                android:layout_marginTop="10dp"
                android:text="@string/test_keyboard_button" />
        </LinearLayout>

        <LinearLayout style="@style/Bento" android:background="@drawable/bento_primary">
            <TextView style="@style/Bento.CardTitle" android:text="@string/copy_translate_title" android:textColor="@color/app_on_primary_soft" />
            <TextView style="@style/Bento.Body" android:text="@string/copy_translate_desc" android:textColor="@color/app_on_primary_soft" />
            <CheckBox
                android:id="@+id/translate_copied_checkbox"
                style="@style/Bento.Choice"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/copy_translate_opt_in"
                android:textColor="@color/app_on_primary_soft" />
        </LinearLayout>

        <LinearLayout style="@style/Bento">
            <TextView style="@style/Bento.CardTitle" android:text="@string/settings_section_typing" />
            <TextView style="@style/Bento.Body" android:text="@string/settings_what_i_speak" />
            <RadioGroup
                android:id="@+id/mode_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">
                <RadioButton android:id="@+id/radio_punglish" style="@style/Bento.Choice" android:minHeight="48dp" android:text="@string/mode_punglish" />
                <RadioButton android:id="@+id/radio_punjabi" style="@style/Bento.Choice" android:minHeight="48dp" android:text="@string/mode_punjabi" />
            </RadioGroup>
            <CheckBox android:id="@+id/auto_send_checkbox" style="@style/Bento.Choice" android:minHeight="48dp" android:text="@string/settings_auto_send" />
            <CheckBox android:id="@+id/offline_mode_checkbox" style="@style/Bento.Choice" android:minHeight="48dp" android:text="@string/settings_offline" />
        </LinearLayout>

        <LinearLayout style="@style/Bento">
            <TextView style="@style/Bento.CardTitle" android:text="@string/settings_section_appearance" />
            <TextView style="@style/Bento.Body" android:text="@string/settings_keyboard_size" />
            <RadioGroup
                android:id="@+id/size_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/size_small" style="@style/Bento.Choice" android:minHeight="48dp" android:text="@string/settings_size_small" />
                <RadioButton android:id="@+id/size_medium" style="@style/Bento.Choice" android:minHeight="48dp" android:text="@string/settings_size_medium" />
                <RadioButton android:id="@+id/size_large" style="@style/Bento.Choice" android:minHeight="48dp" android:text="@string/settings_size_large" />
            </RadioGroup>
            <CheckBox android:id="@+id/double_tap_period_checkbox" style="@style/Bento.Choice" android:minHeight="48dp" android:text="@string/settings_double_tap" />
            <CheckBox android:id="@+id/auto_cap_checkbox" style="@style/Bento.Choice" android:minHeight="48dp" android:text="@string/settings_auto_cap" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_open_personalization"
            style="@style/Bento"
            android:background="@drawable/bento_amber"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="64dp">
            <TextView style="@style/Bento.CardTitle" android:text="@string/my_spellings_title" android:textColor="@color/app_on_amber_soft" />
            <TextView style="@style/Bento.Body" android:text="@string/my_spellings_desc" android:textColor="@color/app_on_amber_soft" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_open_privacy"
            style="@style/Bento"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="64dp">
            <TextView style="@style/Bento.CardTitle" android:text="@string/privacy_title" />
            <TextView style="@style/Bento.Body" android:text="@string/secure_field_explanation" />
        </LinearLayout>

        <LinearLayout style="@style/Bento">
            <TextView style="@style/Bento.CardTitle" android:text="@string/support_title" />
            <TextView android:id="@+id/language_service_status" style="@style/Bento.Body" />
        </LinearLayout>

        <TextView android:id="@+id/btn_save" style="@style/Bento.PillPrimary" android:layout_marginTop="8dp" android:text="@string/settings_save" />
        <TextView android:id="@+id/save_status" style="@style/Bento.Body" android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:textColor="@color/app_primary" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
