<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/activity_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- App Scale Toggle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/btn_app_size_minus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="-"
                    android:textColor="@color/accent_blue"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:background="@drawable/mode_pill_bg"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_app_size_plus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:text="+"
                    android:textColor="@color/accent_blue"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:background="@drawable/mode_pill_bg"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </RelativeLayout>

        <!-- ═══════════ Section 1: Typing Style ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_typing"
                android:textColor="@color/accent_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_what_i_speak"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/mode_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radio_punglish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_punglish"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:buttonTint="@color/accent_blue" />

                <RadioButton
                    android:id="@+id/radio_punjabi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_punjabi"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:buttonTint="@color/accent_blue" />

                <RadioButton
                    android:id="@+id/radio_english"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_english"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:buttonTint="@color/accent_blue" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginVertical="12dp" />

            <CheckBox
                android:id="@+id/auto_send_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_auto_send"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/accent_blue" />

            <CheckBox
                android:id="@+id/offline_mode_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_offline"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/accent_blue" />
        </LinearLayout>

        <!-- ═══════════ Section 2: Appearance ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_appearance"
                android:textColor="@color/accent_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_keyboard_size"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/size_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/size_small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Small"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:buttonTint="@color/accent_blue" />

                <RadioButton
                    android:id="@+id/size_medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mid"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:buttonTint="@color/accent_blue" />

                <RadioButton
                    android:id="@+id/size_large"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Large"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:buttonTint="@color/accent_blue" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginVertical="12dp" />

            <CheckBox
                android:id="@+id/double_tap_period_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_double_tap"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/accent_blue" />

            <CheckBox
                android:id="@+id/auto_cap_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_auto_cap"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:buttonTint="@color/accent_blue" />
        </LinearLayout>

        <!-- ═══════════ Section 3: Personalization ═══════════ -->
        <LinearLayout
            android:id="@+id/btn_open_personalization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_personal"
                android:textColor="@color/accent_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_manage_shortcuts"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_manage_shortcuts_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- ═══════════ Section 4: Advanced ═══════════ -->
        <TextView
            android:id="@+id/btn_advanced_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_advanced"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:padding="8dp"
            android:layout_gravity="center_horizontal" />

        <LinearLayout
            android:id="@+id/advanced_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/api_key_input"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Google Translate API Key"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/mode_pill_bg"
                android:paddingHorizontal="12dp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Save Button -->
        <TextView
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/settings_save"
            android:textColor="@color/key_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/btn_send_bg"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/save_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_green"
            android:textSize="13sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
