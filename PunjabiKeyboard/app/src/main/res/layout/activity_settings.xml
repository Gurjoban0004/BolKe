<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/activity_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ═══════════ Top Header Bar ═══════════ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <!-- Top Left: Explicitly kept empty as requested -->
            <View
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true" />

            <!-- Title: Centered -->
            <TextView
                android:id="@+id/settings_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="ਬੋਲ ਕੇ — Settings"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Top Right: Scale App Size Buttons (- / +) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/btn_app_size_minus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="-"
                    android:textColor="@color/accent_blue"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/mode_pill_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btn_app_size_plus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="+"
                    android:textColor="@color/accent_blue"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/mode_pill_bg"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </RelativeLayout>

        <!-- ═══════════ Card 1: General Preferences (Merged & Decluttered) ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ਕੀਬੋਰਡ ਸੈਟਿੰਗਾਂ — General Options"
                android:textColor="@color/accent_blue"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- 1. Output Mode -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. ਆਉਟਪੁੱਟ ਭਾਸ਼ਾ — Output Mode"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
            
            <RadioGroup
                android:id="@+id/mode_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/radio_punglish"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Punglish"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:buttonTint="@color/accent_blue" />

                <RadioButton
                    android:id="@+id/radio_punjabi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:text="Gurmukhi"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:buttonTint="@color/accent_blue" />

                <RadioButton
                    android:id="@+id/radio_english"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="English"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:buttonTint="@color/accent_blue" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginVertical="6dp" />

            <!-- 2. Keyboard Size -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. ਕੀਬੋਰਡ ਦਾ ਸਾਈਜ਼ — Keyboard Size"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
            
            <RadioGroup
                android:id="@+id/size_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/size_small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Small"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:buttonTint="@color/accent_blue" />

                <RadioButton
                    android:id="@+id/size_medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Medium"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:buttonTint="@color/accent_blue" />

                <RadioButton
                    android:id="@+id/size_large"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Large"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:buttonTint="@color/accent_blue" />

                <RadioButton
                    android:id="@+id/size_xlarge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="XL"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:buttonTint="@color/accent_blue" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginVertical="6dp" />

            <!-- 3. Quick Replies Format -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. ਤੁਰੰਤ ਜਵਾਬ ਫਾਰਮੈਟ — Quick Replies Mode"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
            
            <RadioGroup
                android:id="@+id/qr_format_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/qr_follow_keyboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Follow Keyboard Mode (ਕੀਬੋਰਡ ਦੇ ਅਨੁਸਾਰ)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:buttonTint="@color/accent_blue" />

                <RadioButton
                    android:id="@+id/qr_always_punglish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Always Punglish (ਹਮੇਸ਼ਾ Punglish)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:buttonTint="@color/accent_blue" />

                <RadioButton
                    android:id="@+id/qr_always_punjabi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Always Gurmukhi / Punjabi (ਹਮੇਸ਼ਾ ਪੰਜਾਬੀ)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:buttonTint="@color/accent_blue" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginVertical="6dp" />

            <!-- 4. Switches Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <!-- Auto-Send Switch -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <CheckBox
                        android:id="@+id/auto_send_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/accent_blue" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="2dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ਆਟੋ-ਸੈਂਡ"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto-Send"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Offline Switch -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <CheckBox
                        android:id="@+id/offline_mode_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/accent_blue" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="2dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ਆਫਲਾਈਨ ਮੋਡ"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Force Offline"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- ═══════════ Card 2: Collapsible Help Guide ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btn_help_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 View Voice Setup Guide (ਵੌਇਸ ਗਾਈਡ) ▾"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="4dp" />

            <LinearLayout
                android:id="@+id/help_guide_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="For the best accuracy and instant, offline Punjabi typing, download the Punjabi language model:\n\n1. Open the Google app on your phone.\n2. Tap your profile -> Settings -> Voice.\n3. Tap Offline speech recognition -> 'All' tab.\n4. Search for 'Punjabi' (ਪੰਜਾਬੀ) and download it.\n\nਇਹ ਸੈਟਿੰਗ ਕਰਨ ਨਾਲ ਵੌਇਸ ਟਾਈਪਿੰਗ ਬਿਨਾਂ ਇੰਟਰਨੈੱਟ ਦੇ ਵੀ ਬਹੁਤ ਤੇਜ਼ ਅਤੇ ਸਹੀ ਕੰਮ ਕਰੇਗੀ।"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════ Card 3: Quick Replies ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="ਤੁਰੰਤ ਜਵਾਬ — Quick Replies"
                    android:textColor="@color/accent_blue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_reset_qr_defaults"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Reset Defaults"
                    android:textColor="@color/accent_orange"
                    android:textSize="11sp"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- Dynamic List Container -->
            <LinearLayout
                android:id="@+id/quick_replies_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp" />

            <!-- Add Row Form -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ਨਵਾਂ ਤੁਰੰਤ ਜਵਾਬ ਜੋੜੋ (Add Quick Reply):"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <EditText
                        android:id="@+id/new_qr_punjabi"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:hint="Gurmukhi (e.g. ਕੀ ਹਾਲ ਹੈ?)"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="12sp"
                        android:background="@drawable/mode_pill_bg"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true" />

                    <EditText
                        android:id="@+id/new_qr_punglish"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:hint="Punglish (e.g. ki haal hai?)"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="12sp"
                        android:background="@drawable/mode_pill_bg"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_add_qr"
                    android:layout_width="44dp"
                    android:layout_height="76dp"
                    android:background="@drawable/btn_send_bg"
                    android:text="➕"
                    android:textColor="@color/btn_send_text"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════ Card 4: Slang Mappings ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="ਸ਼ਬਦ ਬਦਲਾਵ — Slang Mappings"
                    android:textColor="@color/accent_blue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_reset_slang_defaults"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Reset Defaults"
                    android:textColor="@color/accent_orange"
                    android:textSize="11sp"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- Dynamic List Container -->
            <LinearLayout
                android:id="@+id/slang_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp" />

            <!-- Add Row Form -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ਨਵਾਂ ਸ਼ਬਦ ਬਦਲਾਵ ਜੋੜੋ (Add Slang Mapping):"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/new_slang_target"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:hint="Spoken (e.g. karo)"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="12sp"
                    android:background="@drawable/mode_pill_bg"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/new_slang_replacement"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:hint="Replaced (e.g. kro)"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="12sp"
                    android:background="@drawable/mode_pill_bg"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/btn_add_slang"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_send_bg"
                    android:text="➕"
                    android:textColor="@color/btn_send_text"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Collapsible API Key section (starts collapsed) -->
        <TextView
            android:id="@+id/btn_advanced_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Advanced Settings (Google Cloud API) ▾"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_gravity="center_horizontal"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/advanced_settings_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google Cloud Translation API Key"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paste your Google Cloud Translation API Key below to translate Punjabi speech to English text."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/api_key_input"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Paste key here..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="12sp"
                android:background="@drawable/mode_pill_bg"
                android:padding="10dp"
                android:inputType="text"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Save Button -->
        <TextView
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Save Settings"
            android:textColor="@color/key_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/btn_send_bg"
            android:clickable="true"
            android:focusable="true" />

        <!-- Status message -->
        <TextView
            android:id="@+id/save_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_green"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
